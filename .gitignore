# Dependencies — reinstallable from package.json/package-lock.json, and
# committing them makes every diff unreadable (a stray `git add -A`
# stages ~4MB of vendor code).
node_modules/

# Secrets — never commit real credentials. .env.example is the tracked
# template; .env itself holds real keys.
.env
.env.local
.env.*.local
backend/.env

.vercel
.kilo
job_log.txt

# MCP server config — entries can carry bearer tokens in `headers`
# (see backend/mcp.example.json, which IS tracked as the template).
backend/mcp.json

# Deployment plane: real secrets and staged user source
infra/deploy/.env
# The agent worker's. Holds MONGODB_URI — the platform database — which
# is the whole reason that worker is a separate stack from the deploy
# plane. Covered by the bare `.env` rule above; named here because the
# other two are, and a rule you can see beats one you have to infer.
infra/agent/.env
infra/deploy/node_modules/
infra/deploy/builds/

# Never commit private keys or env backups.
*.pem
id_ed25519*
id_rsa*
.env.bak*
**/.env.bak.*

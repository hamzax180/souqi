# ── MERVEKS SAP backend configuration ───────────────────────────────
# Copy this file to ".env" and fill in your values.

# MongoDB connection string.
#   • Local Mongo:  mongodb://127.0.0.1:27017
#   • MongoDB Atlas (free M0):
#     mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017

# Database name (created automatically on first write).
DB_NAME=souqi

# Port the API listens on.
PORT=4000

# Allowed browser origin(s) for CORS. Use "*" in dev ONLY. In production, set
# this to your actual domain(s) — e.g. https://souqi.site,https://www.souqi.site
# Leaving "*" in prod lets any origin call your API with credentials.
# Comma-separated allowlist of origins allowed to call this API.
#
# `*` reflects whatever Origin asked, which is fine on localhost and not
# fine in public: the server now REFUSES TO START on '*' when
# NODE_ENV=production, so this has to be set wherever the app is deployed
# (for Vercel that means a project environment variable, not this file —
# server/.env is gitignored and never ships).
#
# Note what CORS is not doing here: sq_session is httpOnly + SameSite=Lax
# and credentials are not enabled on the middleware, so no cross-origin
# page can use a visitor's session whatever this is set to.
CORS_ORIGIN=https://souqi.site,https://www.souqi.site

# Secret used to sign login tokens. MUST be a long random string in prod.
JWT_SECRET=change-this-to-a-long-random-secret-string

# Google Gemini API key — kept server-side so it never ships to the browser.
# Leave blank to disable the live AI proxy (offline engine still works).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# AI adapter (docs/AI-PROVIDER-PLAN.md §3) — routes prose to Gemini, strict
# JSON/coding to DeepSeek, through one client. AI_ENABLED=0 (default) means
# every deterministic path runs exactly as it does with no keys at all;
# this is a strict enhancement, never a dependency.
AI_ENABLED=0
AI_MONTHLY_BUDGET_USD=5

AI_PROSE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_PROSE_MODEL=gemini-3.8-flash
AI_PROSE_KEY=

AI_JSON_BASE_URL=https://api.deepseek.com
AI_JSON_MODEL=deepseek-chat
AI_JSON_KEY=

# The reasoning tier: Power-mode builds and the planner.
#
# Same provider, key and base URL as AI_JSON above — only the model string
# differs, so this is an override rather than a second route. A reasoner
# outage and a chat outage are the same provider outage, and the circuit
# breaker should see them as one.
#
# Unset means "behave exactly as before": every caller falls back to
# AI_JSON_MODEL, so leaving this blank cannot break a deployment. Set it and
# Power mode starts meaning something — until now it bought a longer prompt,
# more tokens and an extra repair round while running the same model as eco.
AI_JSON_POWER_MODEL=deepseek-reasoner

# Vision — looking at photos a client attached, so the agent can place them
# in the site it builds (a logo in the header, a wide shot as the hero).
#
# Its own route rather than a reuse of AI_PROSE, because seeing is a
# capability and not a preference: whatever this deployment has actually set
# AI_PROSE/AI_JSON to may well be text-only, and a text-only model handed an
# image does not decline — it writes a confident description of a photo it
# never received, which then gets cached and used to lay out someone's site.
# So this route never falls back. Unset is fine and handled: the describe
# step degrades to filename-and-size and the build still runs.
#
# Needs a multimodal model. Gemini Flash is the cheap one (an image bills as
# input tokens); any OpenAI-compatible vision endpoint works.
AI_VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_VISION_MODEL=gemini-flash-latest
AI_VISION_KEY=

# Souqi Code (docs/CODE-AGENT-PLAN.md §9): per-owner monthly spend cap, on
# top of (not instead of) AI_MONTHLY_BUDGET_USD above. That one protects
# the whole platform's shared AI budget from running away in aggregate;
# this one stops a single anonymous visitor from being the reason it does.
# 0 disables the check.
CODEAGENT_OWNER_MONTHLY_BUDGET_USD=1

# ---------------------------------------------------------------------
# Bring-your-own-key model providers (the "Model Provider" picker)
# ---------------------------------------------------------------------
# Users can paste their own Anthropic / Gemini / OpenAI / DeepSeek key and
# run their builds on it instead of Souqi's models. Their key is stored
# encrypted against their account, so this is REQUIRED for that feature:
# without it POST /api/account/ai-keys refuses (503) rather than writing a
# live third-party credential to the database in plaintext.
#
# 32 bytes, hex or base64:  openssl rand -hex 32
DB_ENCRYPTION_KEY=

# ---------------------------------------------------------------------
# MCP servers (Powered Souqi only)
# ---------------------------------------------------------------------
# Extra tools the agent can call before it writes code. Either set the
# JSON inline here, or copy server/mcp.example.json to server/mcp.json
# (this variable wins if both exist). Empty = no MCP tools, which is the
# default and is not an error.
#   MCP_SERVERS={"mcpServers":{"docs":{"command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","./docs"]}}}
MCP_SERVERS=

# ─── Container deployments (the deploy plane) ────────────────────────
# The service in deploy/ that builds user apps into Docker images and
# runs them. Unset = the Deployments dashboard shows "not configured"
# and every deploy route answers 503, which is the correct state on a
# machine that is not running the stack.
#
# Locally: docker compose up -d in deploy/ (docker-compose.override.yml
# publishes the API on loopback for exactly this).
#   DEPLOY_API_URL=http://127.0.0.1:4500
#
# In production the deploy API is NOT on the public internet. Point this
# at the control-plane hostname Caddy routes to the api service, and set
# DEPLOY_PLATFORM_TOKEN to the shared secret that hostname requires —
# without it, the deploy API would be sitting on the internet protected
# by session auth alone.
DEPLOY_API_URL=
DEPLOY_PLATFORM_TOKEN=

# ─── Code agent context window ───────────────────────────────────────
# How much of a project's source is shown to the model on a follow-up
# edit. Files are fitted whole where they fit; anything excerpted or left
# out is announced in the prompt itself, so the model never silently
# edits half a file.
#
# Input is cheap (~$0.27 per million tokens), so 120K chars is well under
# a cent per edit — the previous 30K limit was not a cost decision. Raise
# it for large projects; lower it only if you are deliberately trading
# quality for spend.
CODEAGENT_MAX_CODE_CHARS=120000
# Backstop on the whole user message. Keep it above the code budget:
# this one is a hard slice, and slicing here would undo the honesty above.
CODEAGENT_MAX_PROMPT_CHARS=140000

# ─── CAPTCHA (bot protection for signup and public forms) ────────────
# Set CAPTCHA_SECRET to enable. Leave blank to disable (open in dev).
# CAPTCHA_PROVIDER: "turnstile" (Cloudflare, default) or "recaptcha" (Google)
CAPTCHA_SECRET=
CAPTCHA_PROVIDER=turnstile

# ─── Visit tracking salt ─────────────────────────────────────────────
# Random string mixed into the daily visitor hash. Change it to make
# hashes unique to your deployment.
VISIT_SALT=

# ─── Distributed Rate Limiting (Upstash / Vercel KV) ──────────────────
# Optional. On Vercel serverless, in-memory rate limiting resets between
# cold starts. Set these to enable distributed rate limiting via Upstash Redis:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Stripe Connect (lib/stripe.js) — payments inside a generated app.
#
# Souqi is the PLATFORM, not the merchant: an app owner connects their own
# Stripe account over OAuth and charges are created directly on it, so the
# money is theirs and Souqi stores an account id rather than a secret key.
#
# Leave these blank and the integration reports "not available" — nothing
# half-works. Get CLIENT_ID from Stripe Dashboard > Connect > Settings.
STRIPE_CLIENT_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Souqi's cut, in basis points (250 = 2.5%). 0 = no platform fee.
STRIPE_PLATFORM_FEE_BPS=0
# Absolute origin used to build OAuth redirect and Checkout return URLs.
# Falls back to the request's own host when unset — which behind a reverse
# proxy means http:// rather than https://, and Stripe rejects an OAuth
# redirect_uri that does not match the one registered. Set it in production.
PUBLIC_BASE_URL=

# ---- Souqi's OWN subscriptions (the other direction) ----------------
#
# Everything above sells other people's goods. These sell Souqi: /checkout
# charges for Core and Pro on Souqi's own Stripe account, using Elements,
# so the card fields in the page are Stripe iframes and no card number
# reaches this server.
#
# Needs three things, and reports "not configured" without all three:
#   1. STRIPE_SECRET_KEY, shared with the Connect block above;
#   2. the publishable key, which goes into the page;
#   3. a plan catalogue mapping what is SOLD to what is CHARGED and to
#      what the server then gates on.
STRIPE_PUBLISHABLE_KEY=
#
# One JSON object. Per plan:
#   label       what the checkout page calls it
#   entitlement the internal plan id every limit is keyed by — must be one
#               of free/pro/business/max/team/enterprise. Kept separate
#               from the sold name because a tier gets renamed far more
#               often than the code behind it changes.
#   prices      interval -> currency -> Stripe Price id. A currency with
#               no price is simply not offered on the page.
#
# STRIPE_BILLING_PLANS={"core":{"label":"Souqi Core","entitlement":"pro","prices":{"month":{"usd":"price_123"},"year":{"usd":"price_456"}}},"pro":{"label":"Souqi Pro","entitlement":"max","prices":{"month":{"usd":"price_789"},"year":{"usd":"price_abc"}}}}
STRIPE_BILLING_PLANS=
#
# Stripe Tax, if it is switched on in the dashboard. Asking for it when it
# is not available fails the whole subscription, so it is opt-in: 1 to
# enable. Off, the checkout shows no tax line at all rather than inventing
# a rate.
STRIPE_AUTOMATIC_TAX=
#
# The webhook endpoint above carries these too. Point one endpoint at
# POST /api/stripe/webhook and subscribe it to, at minimum:
#   checkout.session.completed          (Connect: a shopper paid an owner)
#   customer.subscription.created
#   customer.subscription.updated
#   customer.subscription.deleted       (Souqi: a plan started or changed)

# ─── Object storage for image uploads (S3-compatible: R2, S3, MinIO) ───
#
# LEAVING THESE BLANK IS A SUPPORTED CONFIGURATION, not a broken one. With
# no bucket the bytes go into MongoDB and are served back through
# /api/img/*, which is what keeps image upload working at all — before the
# fallback existed, unset S3 meant POST /api/uploads/sign answered 503 and
# the feature was simply off.
#
# What the fallback costs, so it is a choice and not a surprise:
#   - the per-image limit drops from 10MB to 2MB, because a Vercel function
#     cannot RETURN a response much over 4.5MB and every view comes back
#     through one;
#   - every image view on every published site is a function invocation and
#     a read out of the database;
#   - those bytes are permanent once the image is used in a build, and they
#     share the cluster's storage quota with everything else.
# It is a bridge to a bucket, not a destination.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
#
# MUST be a domain we own (cdn.souqi.site), never the provider's *.r2.dev:
# these strings are baked permanently into published customer source, and a
# domain we control can be re-pointed at another bucket while a provider
# hostname cannot. Do NOT set this until the backfill has finished — see
# the switch-over note in lib/storage/blobs.js.
S3_PUBLIC_BASE_URL=
#
# auto | s3 | db. "db" is the reversible switch: it stops WRITING to the
# bucket while reads still fall through to it. Unsetting the credentials
# above is the destructive operation, because anything already written to
# the bucket then has nothing that can reach it.
BLOB_BACKEND=auto
#
# The database-path ceiling, and the size of one slice of the upload. The
# slice must stay under Vercel's ~4.5MB REQUEST cap; the ceiling is set by
# the ~4.5MB RESPONSE cap, which is the lower of the two constraints.
UPLOADS_MAX_BYTES_DB=2097152
UPLOADS_PART_BYTES=1048576

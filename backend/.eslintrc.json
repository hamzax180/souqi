{
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022
  },
  "rules": {
    "no-undef": "warn",
    "no-unused-vars": ["warn", { "args": "none" }],
    "no-console": "off",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-func": "error",
    "eqeqeq": ["warn", "always"],
    "no-var": "warn",
    "prefer-const": "warn"
  },
  "ignorePatterns": [
    "node_modules/",
    "vendor/",
    "lib/codeagent/scaffold/",

    // Generated from backend/agent-src/ by `npm run build:agent`.
    //
    // Linting compiler output is noise: these rules are about how a
    // person writes JavaScript, and nobody wrote these. tsc's own
    // __importStar helpers alone account for seven no-var errors that
    // cannot be fixed without editing a file the next build overwrites.
    // The SOURCES are checked instead, by `npm run typecheck`, which is
    // strict and has no warning budget to drift.
    "lib/codeagent/*.js",
    "lib/codeagent/runtimes/*.js",
    "worker/*.js"
  ]
}

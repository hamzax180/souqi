# =================================================================
#  infra/agent/.env — the code agent's durable worker
#  -----------------------------------------------------------------
#  Built locally, checked, and copied to the host by ship.sh. Never
#  generated on the server, for the same reason the deploy plane's is
#  not: the values should live somewhere you control rather than being
#  invented on a box you might later rebuild.
#
#  chmod 600 on the host. This file holds the platform database.
# =================================================================

# --- the platform database ---------------------------------------
# The same Atlas cluster the API uses. This is the credential that
# makes this stack a decision: it is why the worker is here and not in
# infra/deploy, which holds a Docker socket and must not also hold
# write access to every customer's projects.
MONGODB_URI=
DB_NAME=
MONGO_MAX_POOL=5

# --- the build sandbox, on the deploy plane ----------------------
# TWO tokens, because there are two gates. The control hostname is
# fenced app-wide by x-platform-token before any route is reached; the
# verifier route is then fenced by x-internal-token. Sending only the
# second gets a flat 401 and never reaches the route.
#
# The TRAILING SLASH is load-bearing: paths join relative to it, and
# without it `new URL("/health", base)` discards the path and hits the
# plane's own public /health — reading a healthy plane as a healthy
# verifier.
AGENT_VERIFIER_URL=https://deploy.souqi.site/internal/agent/
AGENT_VERIFIER_TOKEN=
DEPLOY_PLATFORM_TOKEN=

# --- the model ---------------------------------------------------
# One route per purpose, each with its own base URL, key and model —
# the same values backend/.env carries. AI_ENABLED is the master
# switch: without it the client refuses every call, and the worker
# claims runs only to fail them.
AI_ENABLED=1
AI_JSON_BASE_URL=
AI_JSON_KEY=
AI_JSON_MODEL=
AI_JSON_POWER_MODEL=
AI_PROSE_BASE_URL=
AI_PROSE_KEY=
AI_PROSE_MODEL=
AI_VISION_BASE_URL=
AI_VISION_KEY=
AI_VISION_MODEL=
AI_MONTHLY_BUDGET_USD=

# --- the run's own limits ----------------------------------------
# Thirty minutes, against the serverless path's five. This is the
# whole point of the stack: a run here may take the time its effort
# level promises rather than being terminated at 300 seconds.
CODEAGENT_MAX_RUN_MS=1800000
CODEAGENT_FINISH_RESERVE_MS=30000

# Must match the API's, or an approval token signed there will not
# verify here and every plan-mode run is refused.
CODEAGENT_APPROVAL_SECRET=
JWT_SECRET=

# How many worker containers claim runs. One meant the whole platform
# built one app at a time — see the note in docker-compose.yml. Never
# higher than AGENT_SANDBOX_CONTAINERS on the deploy plane: a worker
# without a build sandbox turns a queue into a fake compile error.
AGENT_WORKERS=2
